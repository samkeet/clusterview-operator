# Copy to .env and fill in real values:  cp .env.example .env
# Then start a session with:  source .env && claude
# .env is gitignored. Never commit it or paste its contents anywhere.

# Claude Code via OpenRouter (Anthropic-compatible endpoint).
export OPENROUTER_API_KEY=<your-openrouter-api-key>
export ANTHROPIC_BASE_URL="<openrouter-anthropic-compatible-base-url>"
export ANTHROPIC_AUTH_TOKEN="$OPENROUTER_API_KEY"
# Left empty on purpose, so Claude Code uses ANTHROPIC_AUTH_TOKEN instead.
export ANTHROPIC_API_KEY=""
export ANTHROPIC_DEFAULT_OPUS_MODEL="<opus-model-id>"
export ANTHROPIC_DEFAULT_SONNET_MODEL="<sonnet-model-id>"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="<haiku-model-id>"
# Separate Claude Code config/state for this setup.
export CLAUDE_CONFIG_DIR="$HOME/<claude-config-dir>"

# Kubeconfig for the DOKS cluster (kept under .kube/, which is gitignored).
export KUBECONFIG="$HOME/dev/clusterview-operator/.kube/config.yaml"
