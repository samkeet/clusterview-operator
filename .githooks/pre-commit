#!/bin/sh
# gofmt on staged Go files. Enable once per clone: git config core.hooksPath .githooks
set -eu
cd "$(git rev-parse --show-toplevel)"
files=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)
[ -z "$files" ] && exit 0
bad=$(gofmt -l $files)
if [ -n "$bad" ]; then echo "gofmt needed on:" >&2; echo "$bad" >&2; exit 1; fi
