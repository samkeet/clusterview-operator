#!/bin/sh
# Replaces the old Lint and Tests workflows. Enable once per clone: git config core.hooksPath .githooks
# E2E (needs kind + Docker) is manual: Actions tab > E2E Tests > Run workflow, or `make test-e2e`.
# Skip in an emergency: git push --no-verify
set -eu
cd "$(git rev-parse --show-toplevel)"
make lint-config lint
go mod tidy -diff
make test
